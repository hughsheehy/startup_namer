// The web build, served at startupnames.loudvector.com by a Cloudflare Worker
// with static assets (no code of its own).
// Build, then deploy from this folder:
//   python3 tool/build_web.py     (flutter build web --wasm, then stamps sw.js)
//   npx wrangler deploy
{
  "name": "startupnames",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./build/web" },
  "routes": [{ "pattern": "startupnames.loudvector.com", "custom_domain": true }]
}
